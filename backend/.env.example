# ==============================================================================
# WindCast Analytics - Backend Environment Variables Example
# ==============================================================================
#
# PORT:
# Port on which the FastAPI application will listen.
# Automatically set by most PaaS providers (Render, Heroku).
# Default: 8000
PORT=8000

# CORS_ORIGINS:
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# In local development: leave empty or unset to allow default dev origins
# (http://localhost:5173, http://127.0.0.1:5173, http://localhost:3000, http://127.0.0.1:3000).
# In production: set this to your deployed frontend URL(s).
# Example:
# CORS_ORIGINS=https://windcast-analytics.vercel.app,http://localhost:3000
CORS_ORIGINS=
