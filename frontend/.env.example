# ==============================================================================
# WindCast Analytics - Frontend Environment Variables Example
# ==============================================================================
#
# LOCAL DEVELOPMENT & DOCKER COMPOSE:
# Leave VITE_API_BASE_URL empty or unset.
# - In local dev (Vite): Requests to /api are proxied to http://127.0.0.1:8000.
# - In Docker Compose: Requests to /api are reverse-proxied by NGINX to http://backend:8000.
#
# VERCEL PRODUCTION DEPLOYMENT:
# Set this variable in your Vercel Project Settings -> Environment Variables
# pointing to your deployed FastAPI backend URL (without trailing slash):
# Example:
# VITE_API_BASE_URL=https://windcast-backend.onrender.com

VITE_API_BASE_URL=
